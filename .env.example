# Veles-MOEX — пример конфигурации для локального запуска.
# Скопируйте файл в `.env` (лежит в корне репозитория) и заполните значения.
# `.env` в репозиторий не попадает: он игнорируется .gitignore.

# --- Режим ---
# development | production
ENVIRONMENT=development

# --- T-Invest API (основной контур) ---
# Токен из https://www.tinkoff.ru/invest/settings/
TINVEST_TOKEN=
# Для песочницы (тестовый контур) — true. Стоп-заявки в песочнице недоступны.
TINVEST_SANDBOX=true
# Живая торговля (реальные заявки) — выключена по умолчанию.
LIVE_TRADING_ENABLED=false

# --- Локальный запуск (режим разработки, вне docker) ---
# PostgreSQL/Redis в docker-compose: порты 5432/6379 уже проброшены на 127.0.0.1.
DATABASE_URL=postgresql+asyncpg://veles:veles@localhost:5432/veles_moex
REDIS_URL=redis://localhost:6379/0

# --- CORS ---
# Список источников через запятую или JSON-массив.
CORS_ORIGINS=http://localhost:5173

# --- Бэктест (ops-параметры) ---
# Максимум свечей на один запуск бэктеста через API.
BACKTEST_MAX_CANDLES=10000
