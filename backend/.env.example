# Application settings template. Copy to `.env` and fill in.
# Do NOT commit `.env` with real secrets.
APP_NAME=Veles-MOEX
ENVIRONMENT=development
API_V1_PREFIX=/api

DATABASE_URL=postgresql+asyncpg://veles:veles@localhost:5432/veles_moex
REDIS_URL=redis://localhost:6379/0

# JSON array (or comma-separated string) of allowed CORS origins.
CORS_ORIGINS=["http://localhost:5173"]
