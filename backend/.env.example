# Application settings template. Copy to `.env` and fill in.
# Do NOT commit `.env` with real secrets.
APP_NAME=Veles-MOEX
ENVIRONMENT=development
API_V1_PREFIX=/api

DATABASE_URL=postgresql+asyncpg://veles:veles@localhost:5432/veles_moex
REDIS_URL=redis://localhost:6379/0

# JSON array (or comma-separated string) of allowed CORS origins.
CORS_ORIGINS=["http://localhost:5173"]

# T-Invest API token (read-only integration). Placeholder only; never commit a real token.
# Set it in the environment, e.g.  $env:TINVEST_TOKEN="..."
TINVEST_TOKEN=your_token_here
# Official production REST endpoint. Optionally point to the sandbox.
TINVEST_BASE_URL=https://invest-public-api.tbank.ru/rest
